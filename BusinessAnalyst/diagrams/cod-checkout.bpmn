<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_MinimalMarketplace" targetNamespace="https://example.local/minimal-marketplace/bpmn">
  <bpmn:process id="Process_COD" name="Member COD checkout and Seller payment confirmation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_COD">
      <bpmn:lane id="Lane_Member" name="Member">
        <bpmn:flowNodeRef>Start_Cart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitCheckout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Platform" name="Marketplace platform">
        <bpmn:flowNodeRef>Gateway_Authenticated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Seller" name="Seller">
        <bpmn:flowNodeRef>Task_ReceiveCash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkPaid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Paid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Cart" name="Cart ready">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ReviewCart" name="Review cart">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Authenticated" name="Signed in?" default="Flow_5">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SignIn" name="Sign in">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SubmitCheckout" name="Submit COD order">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Validate" name="Validate USD, stock">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Valid?" default="Flow_8">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Reject" name="Show error">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Rejected" name="Rejected">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CreateOrder" name="Create order atomically">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ShowOrder" name="Show Pending Payment">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ReceiveCash" name="Receive COD cash">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MarkPaid" name="Mark own portion Paid">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Paid" name="Paid">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Cart" targetRef="Task_ReviewCart" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReviewCart" targetRef="Gateway_Authenticated" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_Authenticated" targetRef="Task_SignIn" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_SignIn" targetRef="Task_SubmitCheckout" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Authenticated" targetRef="Task_SubmitCheckout" name="Yes" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_SubmitCheckout" targetRef="Task_Validate" name="" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Validate" targetRef="Gateway_Valid" name="" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Valid" targetRef="Task_Reject" name="No" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Reject" targetRef="End_Rejected" name="" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Valid" targetRef="Task_CreateOrder" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CreateOrder" targetRef="Task_ShowOrder" name="" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ShowOrder" targetRef="Task_ReceiveCash" name="" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ReceiveCash" targetRef="Task_MarkPaid" name="" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_MarkPaid" targetRef="End_Paid" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_COD">
    <bpmndi:BPMNPlane id="BPMNPlane_COD" bpmnElement="Process_COD">
      <bpmndi:BPMNShape id="Shape_Lane_Member" bpmnElement="Lane_Member" isHorizontal="true">
        <dc:Bounds x="20" y="60" width="1780" height="135" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Platform" bpmnElement="Lane_Platform" isHorizontal="true">
        <dc:Bounds x="20" y="195" width="1780" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Seller" bpmnElement="Lane_Seller" isHorizontal="true">
        <dc:Bounds x="20" y="365" width="1780" height="135" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Cart" bpmnElement="Start_Cart">
        <dc:Bounds x="150" y="107" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReviewCart" bpmnElement="Task_ReviewCart">
        <dc:Bounds x="230" y="90" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Authenticated" bpmnElement="Gateway_Authenticated">
        <dc:Bounds x="390" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SignIn" bpmnElement="Task_SignIn">
        <dc:Bounds x="475" y="90" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SubmitCheckout" bpmnElement="Task_SubmitCheckout">
        <dc:Bounds x="640" y="90" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Validate" bpmnElement="Task_Validate">
        <dc:Bounds x="810" y="230" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Valid" bpmnElement="Gateway_Valid">
        <dc:Bounds x="990" y="240" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Reject" bpmnElement="Task_Reject">
        <dc:Bounds x="1090" y="205" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Rejected" bpmnElement="End_Rejected">
        <dc:Bounds x="1260" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CreateOrder" bpmnElement="Task_CreateOrder">
        <dc:Bounds x="1090" y="285" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ShowOrder" bpmnElement="Task_ShowOrder">
        <dc:Bounds x="1260" y="285" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReceiveCash" bpmnElement="Task_ReceiveCash">
        <dc:Bounds x="1420" y="395" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_MarkPaid" bpmnElement="Task_MarkPaid">
        <dc:Bounds x="1580" y="395" width="125" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Paid" bpmnElement="End_Paid">
        <dc:Bounds x="1750" y="412" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="186" y="125" />
        <di:waypoint x="230" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="350" y="125" />
        <di:waypoint x="370" y="125" />
        <di:waypoint x="370" y="250" />
        <di:waypoint x="390" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="415" y="225" />
        <di:waypoint x="415" y="180" />
        <di:waypoint x="535" y="180" />
        <di:waypoint x="535" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="595" y="125" />
        <di:waypoint x="640" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="440" y="250" />
        <di:waypoint x="615" y="250" />
        <di:waypoint x="615" y="125" />
        <di:waypoint x="640" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="760" y="125" />
        <di:waypoint x="785" y="125" />
        <di:waypoint x="785" y="265" />
        <di:waypoint x="810" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="940" y="265" />
        <di:waypoint x="990" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="1040" y="265" />
        <di:waypoint x="1060" y="265" />
        <di:waypoint x="1060" y="240" />
        <di:waypoint x="1090" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9">
        <di:waypoint x="1215" y="240" />
        <di:waypoint x="1260" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1015" y="290" />
        <di:waypoint x="1015" y="320" />
        <di:waypoint x="1090" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1215" y="320" />
        <di:waypoint x="1260" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1385" y="320" />
        <di:waypoint x="1400" y="320" />
        <di:waypoint x="1400" y="430" />
        <di:waypoint x="1420" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="1545" y="430" />
        <di:waypoint x="1580" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14">
        <di:waypoint x="1705" y="430" />
        <di:waypoint x="1750" y="430" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>