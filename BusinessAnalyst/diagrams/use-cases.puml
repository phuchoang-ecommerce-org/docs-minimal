@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F7FAFC
  BorderColor #475569
}
actor Guest
actor Member
actor Seller
actor "Marketplace Admin" as Admin
rectangle "Minimal Marketplace" {
  usecase "UC-01\nBrowse and search" as UC01
  usecase "UC-02\nManage cart" as UC02
  usecase "UC-03\nRegister or sign in" as UC03
  usecase "UC-04\nPlace COD order" as UC04
  usecase "UC-05\nCancel unpaid order" as UC05
  usecase "UC-06\nManage catalog, stock, images" as UC06
  usecase "UC-07\nMark own portion Paid" as UC07
  usecase "UC-08\nRate and review paid product" as UC08
  usecase "UC-09\nGovern Sellers and categories" as UC09
  usecase "UC-10\nModerate reviews and audit" as UC10
}
Guest --> UC01
Guest --> UC02
Guest --> UC03
Member --> UC01
Member --> UC02
Member --> UC04
Member --> UC05
Member --> UC08
Seller --> UC06
Seller --> UC07
Admin --> UC09
Admin --> UC10
UC04 ..> UC03 : <<requires prior sign-in>>
@enduml
